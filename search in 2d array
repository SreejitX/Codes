#include<stdio.h>
int main()
{
    int a[3][3];
    int i,j,search,found=0;
    printf("Enter elements of 3x3 array");
for(i=0;i<3;i++)
{
    for(j=0;j<3;j++)
    {
        scanf("%d",&a[i][j]);
    }
}
printf("Enter elements to search:");
scanf("%d",&search);
for(i=0;i<3;i++)
{
    for(j=0;j<3;j++)
    {
        if(a[i][j]==search)
        {
            printf("Elements found at position [%d][%d]",i,j);
            found = 1;
        }
    }
}
if (found == 0)
{
    printf("Elements not found");
}
return 0;
}
